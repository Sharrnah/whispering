# Build and test only inside Docker. Debian 12 sets the glibc floor to 2.36.
FROM golang:1.26.5-bookworm AS go
FROM debian:bookworm-slim AS audiocpp
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git build-essential cmake ninja-build python3 patchelf \
    glslc libvulkan-dev spirv-headers \
    && rm -rf /var/lib/apt/lists/*
COPY linux-audiocpp-build.py /build-audiocpp.py
RUN python3 /build-audiocpp.py

FROM python:3.11.6-bookworm

ARG PYINSTALLER_VERSION=6.22.2
ARG PORTAUDIO_REVISION=a4dbf68c51fd32734f32657db64849aac24739e7
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    GOPATH=/go \
    PATH=/usr/local/go/bin:$PATH
COPY --from=go /usr/local/go /usr/local/go
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    portaudio19-dev libasound2-dev libpulse-dev libsndfile1 ffmpeg \
    libgl1-mesa-dev xorg-dev libxkbcommon-dev libwayland-dev \
    xvfb xauth pulseaudio pulseaudio-utils dbus-x11 xdotool \
    zip unzip patchelf libgomp1 espeak-ng cmake \
    && rm -rf /var/lib/apt/lists/*
# Debian's released PortAudio lacks the native PulseAudio host API. Build it
# locally so Python and the UI can address PulseAudio/PipeWire source/sink IDs.
RUN git clone https://github.com/PortAudio/portaudio.git /tmp/portaudio \
    && git -C /tmp/portaudio checkout ${PORTAUDIO_REVISION} \
    && cmake -S /tmp/portaudio -B /tmp/portaudio-build \
       -DPA_BUILD_SHARED_LIBS=ON -DPA_BUILD_EXAMPLES=OFF -DPA_BUILD_TESTS=OFF \
       -DPA_USE_PULSEAUDIO=ON -DPA_USE_ALSA=ON -DPA_USE_JACK=ON -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/portaudio-build --parallel 4 \
    && cmake --install /tmp/portaudio-build && ldconfig \
    && rm -rf /tmp/portaudio /tmp/portaudio-build
# pip 24 retains support for legacy fairseq/OmegaConf wheel metadata.
RUN python -m pip install pip==24.0 setuptools==75.8.0 wheel \
    pyinstaller==${PYINSTALLER_VERSION} Cython==3.2.4 flit-core==3.12.0
COPY --from=audiocpp /opt/audio-cpp /opt/audio-cpp
COPY entrypoint-linux.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh
WORKDIR /work
ENTRYPOINT ["/entrypoint.sh"]
