+			t.Fatal(err)
+		}
+		if BackendInstalled(root) {
+			t.Fatal("Windows executable counted as Linux backend")
+		}
+	}
+	if err := os.WriteFile(BackendExecutable(root), []byte("native"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if !BackendInstalled(root) {
+		t.Fatal("native backend not detected")
+	}
